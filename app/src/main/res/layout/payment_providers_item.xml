<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <az.btb.mobilebanking.utils.ConstraintLayoutWithDisableSupport
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/twelve_dp"
        android:background="@drawable/my_items_list_item_shape">

        <ImageView
            android:id="@+id/provider_icon"
            android:layout_width="@dimen/thirty_two_dp"
            android:layout_height="@dimen/thirty_two_dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:background="@tools:sample/avatars"/>

        <TextView
            android:id="@+id/provider_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sixteen_dp"
            android:gravity="center_vertical"
            android:drawablePadding="@dimen/ten_dp"
            android:drawableEnd="@drawable/ic_arrow_next"
            app:layout_constraintStart_toEndOf="@id/provider_icon"
            app:layout_constraintTop_toTopOf="@id/provider_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/provider_icon"
            tools:text="@tools:sample/full_names" />
    </az.btb.mobilebanking.utils.ConstraintLayoutWithDisableSupport>
</layout>