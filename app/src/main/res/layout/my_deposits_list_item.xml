<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.my_items.my_deposits.MyDepositsFragment">

    <data>
        <variable name="depositType" type="String" />
        <variable name="depositAmount" type="java.math.BigDecimal" />
        <variable name="depositCurrency" type="String" />
        <variable name="depositPercent" type="java.math.BigDecimal" />
        <variable name="depositAccountNumber" type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/six_dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/my_items_list_item_shape">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/sixteen_dp"
            android:layout_marginTop="@dimen/twenty_four_dp"
            android:layout_marginBottom="@dimen/twenty_four_dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{depositType}'
                android:textSize="15sp"
                tools:text="Muddetli" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/four_dp"
                android:text='@{@string/my_deposit_amount_and_interest(depositAmount, depositCurrency, depositPercent)}'
                android:textSize="15sp"
                tools:text="1000 AZN / 6%" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{depositAccountNumber}'
                android:textSize="15sp"
                tools:text="41210944066168000015" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>