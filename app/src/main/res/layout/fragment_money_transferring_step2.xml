<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:mask="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.money_transfers.transferring.step2.MoneyTransferringFragment">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topPanel"
            android:layout_width="match_parent"
            android:layout_height="56dp">

            <ImageView
                android:id="@+id/goBack"
                style="@style/Widget.AppCompat.ActionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/go_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transfer"
                android:textAlignment="center"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="@dimen/sixteen_dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/receiver" />

                <EditText
                    android:id="@+id/personName"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="@dimen/six_dp"
                    android:layout_marginBottom="@dimen/sixteen_dp"
                    android:background="@drawable/shape_edit_text_selector"
                    android:gravity="center|start"
                    android:hint="@string/name"
                    android:inputType="textPersonName"
                    android:paddingStart="@dimen/twenty_four_dp"
                    android:paddingEnd="@dimen/twenty_four_dp"
                    android:textColor="@color/textColor"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/personSurname"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="@dimen/sixteen_dp"
                    android:background="@drawable/shape_edit_text_selector"
                    android:gravity="center|start"
                    android:hint="@string/surname"
                    android:inputType="textPersonName"
                    android:paddingStart="@dimen/twenty_four_dp"
                    android:paddingEnd="@dimen/twenty_four_dp"
                    android:textColor="@color/textColor"
                    android:textSize="17sp" />

                <EditText
                    android:id="@+id/personFatherName"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="@dimen/sixteen_dp"
                    android:background="@drawable/shape_edit_text_selector"
                    android:gravity="center|start"
                    android:hint="@string/father_name"
                    android:inputType="textPersonName"
                    android:paddingStart="@dimen/twenty_four_dp"
                    android:paddingEnd="@dimen/twenty_four_dp"
                    android:textColor="@color/textColor"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/receiver_phone_number"
                    android:layout_marginTop="@dimen/twenty_four_dp" />

                <az.btb.mobilebanking.utils.masked_edittext.MaskedEditText
                    android:id="@+id/receiver_number"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="@dimen/six_dp"
                    android:layout_marginBottom="@dimen/sixteen_dp"
                    android:background="@drawable/shape_edit_text_selector"
                    android:gravity="center|start"
                    mask:allowed_chars="1234567890"
                    mask:mask="+994 ## ### ## ##"
                    android:inputType="phone"
                    android:paddingStart="@dimen/twenty_four_dp"
                    android:paddingEnd="@dimen/twenty_four_dp"
                    android:textColor="@color/textColor"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/operation_amount"
                    android:layout_marginTop="@dimen/twenty_four_dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/twenty_four_dp">

                    <EditText
                        android:id="@+id/transfer_amount"
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_marginTop="@dimen/six_dp"
                        android:layout_marginEnd="@dimen/twenty_dp"
                        android:background="@drawable/shape_edit_text_selector"
                        android:layout_weight="1"
                        android:gravity="center|start"
                        android:hint="@string/transfer_amount"
                        android:inputType="numberDecimal"
                        android:paddingStart="@dimen/twenty_four_dp"
                        android:paddingEnd="@dimen/twenty_four_dp"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="55dp"
                        android:layout_weight="0.5"
                        android:layout_marginTop="@dimen/six_dp"
                        android:background="@drawable/gradient_spinner">

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/currencies"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:overlapAnchor="false" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/go_to_step3"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginBottom="@dimen/thirty_six_dp"
                    android:enabled="false"
                    android:background="@drawable/shape_button_selector"
                    android:elevation="3dp"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/next"
                        android:textColor="@color/white"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>