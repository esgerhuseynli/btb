<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:indeterminate="true"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_lock"
            android:layout_marginTop="50dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/pinText"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/put_pin_code"
            android:textColor="@color/textColor"
            android:textSize="21sp"
            android:textAlignment="center"
            android:fontFamily="@font/sf_pro_semibold"
            app:layout_constraintEnd_toEndOf="@id/lock"
            app:layout_constraintStart_toStartOf="@id/lock"
            app:layout_constraintTop_toBottomOf="@id/lock" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pinLayout"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            app:layout_constraintEnd_toEndOf="@id/pinText"
            app:layout_constraintStart_toStartOf="@id/pinText"
            app:layout_constraintTop_toBottomOf="@+id/pinText">

            <ImageView
                android:id="@+id/pin1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_count_not_selected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/pin2"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/pin2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_count_not_selected"
                app:layout_constraintStart_toEndOf="@id/pin1"
                app:layout_constraintEnd_toStartOf="@id/pin3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/pin3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_count_not_selected"
                app:layout_constraintStart_toEndOf="@id/pin2"
                app:layout_constraintEnd_toStartOf="@id/pin4"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/pin4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_count_not_selected"
                app:layout_constraintStart_toEndOf="@id/pin3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/pinText2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pin_ask_policy"
            android:textColor="@color/textColorLight"
            android:textSize="17sp"
            android:gravity="center"
            app:layout_constraintBottom_toTopOf="@id/inputLayout"
            app:layout_constraintEnd_toEndOf="@id/pinLayout"
            app:layout_constraintStart_toStartOf="@id/pinLayout"
            app:layout_constraintTop_toBottomOf="@+id/pinLayout" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/inputLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pinText2">

            <TextView
                android:id="@+id/number1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="1"
                android:tag="1"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number5"
                app:layout_constraintEnd_toStartOf="@id/number2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/number2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="2"
                android:tag="2"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number5"
                app:layout_constraintEnd_toStartOf="@id/number3"
                app:layout_constraintStart_toEndOf="@id/number1"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/number3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="3"
                android:tag="3"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/number2"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/number4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="4"
                android:tag="4"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number8"
                app:layout_constraintEnd_toStartOf="@id/number2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/number1" />

            <TextView
                android:id="@+id/number5"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="5"
                android:tag="5"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number8"
                app:layout_constraintEnd_toStartOf="@id/number3"
                app:layout_constraintStart_toEndOf="@id/number1"
                app:layout_constraintTop_toBottomOf="@id/number1" />

            <TextView
                android:id="@+id/number6"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="6"
                android:tag="6"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/number2"
                app:layout_constraintTop_toBottomOf="@id/number1" />

            <TextView
                android:id="@+id/number7"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="7"
                android:tag="7"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number0"
                app:layout_constraintEnd_toStartOf="@id/number2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/number4" />

            <TextView
                android:id="@+id/number8"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="8"
                android:tag="8"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number0"
                app:layout_constraintEnd_toStartOf="@id/number3"
                app:layout_constraintStart_toEndOf="@id/number1"
                app:layout_constraintTop_toBottomOf="@id/number4" />

            <TextView
                android:id="@+id/number9"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="9"
                android:tag="9"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/number2"
                app:layout_constraintTop_toBottomOf="@id/number4" />

            <TextView
                android:id="@+id/number0"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="0"
                android:tag="0"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/number8"
                app:layout_constraintStart_toStartOf="@id/number8"
                app:layout_constraintTop_toBottomOf="@id/number8" />

            <TextView
                android:id="@+id/numberX"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="@string/delete"
                android:tag="x"
                android:textStyle="bold"
                android:textColor="@color/textColorLight"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/number9"
                app:layout_constraintStart_toStartOf="@id/number9"
                app:layout_constraintTop_toBottomOf="@id/number9" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
