<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.my_items.my_accounts.MyAccountsFragment">

    <data>
        <variable name="accountAltName" type="String" />
        <variable name="accountNumber" type="String" />
        <variable name="accountBalance" type="java.math.BigDecimal" />
        <variable name="accountBalanceCurrency" type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/six_dp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/my_items_list_item_shape">

        <ImageView
            android:id="@+id/account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sixteen_dp"
            android:layout_marginTop="@dimen/twenty_four_dp"
            android:layout_marginBottom="@dimen/twenty_four_dp"
            android:src="@drawable/ic_my_bank_account"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <LinearLayout
            android:id="@+id/accountInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/eight_dp"
            app:layout_constraintStart_toEndOf="@id/account"
            app:layout_constraintTop_toTopOf="@id/account"
            app:layout_constraintBottom_toBottomOf="@id/account">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{accountAltName}'
                android:textSize="14sp"
                tools:text="acccountun alt name-i" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text='@{accountNumber}'
                android:textSize="10sp"
                tools:text="AZ94BBTB41020840066168000000" />
        </LinearLayout>

        <TextView
            android:id="@+id/accountBalanceWithCurrency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/sixteen_dp"
            android:text='@{@string/my_items_item_balance(accountBalance, accountBalanceCurrency)}'
            android:textSize="16sp"
            android:textAlignment="viewEnd"
            app:layout_constraintStart_toEndOf="@id/accountInfo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="4126.28 AZN" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>