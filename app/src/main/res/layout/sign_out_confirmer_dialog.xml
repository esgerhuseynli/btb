<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/twenty_four_dp"
    android:background="@drawable/id_card_fin_code_help_background">

    <TextView
        android:id="@+id/successText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:text="@string/are_you_sure_to_sign_out"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/no"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="@dimen/sixteen_dp"
        android:layout_marginTop="@dimen/twenty_four_dp"
        android:layout_marginEnd="@dimen/sixteen_dp"
        android:layout_marginBottom="@dimen/sixteen_dp"
        android:background="@drawable/shape_edit_text_selector"
        android:elevation="3dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/successText"
        app:layout_constraintTop_toBottomOf="@id/successText"
        app:layout_constraintEnd_toStartOf="@id/yes">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/yes"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="@dimen/sixteen_dp"
        android:layout_marginTop="@dimen/twenty_four_dp"
        android:layout_marginEnd="@dimen/sixteen_dp"
        android:layout_marginBottom="@dimen/sixteen_dp"
        android:background="@drawable/shape_button_enabled"
        android:elevation="3dp"
        android:gravity="center"
        app:layout_constraintStart_toEndOf="@id/no"
        app:layout_constraintTop_toBottomOf="@id/successText"
        app:layout_constraintEnd_toEndOf="@id/successText">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/yes"
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
