<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable name="status" type="Integer" />
        <variable
            name="mobilePayment"
            type="az.btb.mobilebanking.models.MobilePayment" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/id_card_fin_code_help_background">

        <ImageView
            android:id="@+id/closeDialog"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_close"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/payment_status_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/closeDialog"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/ic_error_big" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/twenty_four_dp"
            app:layout_constraintTop_toBottomOf="@id/payment_status_icon"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/provider"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{mobilePayment.paymentProviderName}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="Nar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/twenty_four_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_date"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{mobilePayment.paymentDateTime}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="20.12.35 11:35" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/twenty_four_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{status}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="ugurlu" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility='@{mobilePayment.mobilePaymentStatus == 3 ? View.VISIBLE : View.GONE}'>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/twenty_four_dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ignore_reason"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text='@{mobilePayment.paymentDeclineReason}'
                            android:layout_weight="0.8"
                            android:gravity="end"
                            android:textSize="15sp"
                            tools:text="ugurlu" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/twenty_four_dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ignore_date"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text='@{mobilePayment.paymentDeclineDateTime}'
                            android:layout_weight="0.8"
                            android:gravity="end"
                            android:textSize="15sp"
                            tools:text="ugurlu" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/twenty_four_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text='@{mobilePayment.payerInfo.paymentFromType == 2 ? @string/from_card : @string/from_account}'
                        android:textSize="15sp"
                        tools:text="kartdan/hesabdan" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{mobilePayment.payerInfo.paymentFromType == 2 ? (mobilePayment.payerInfo.fromCardNumber.isEmpty ? mobilePayment.payerInfo.fromIdCard : mobilePayment.payerInfo.fromCardNumber) : mobilePayment.payerInfo.fromIbanAccount}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="kart nomresi yaxud iban" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/twenty_four_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/transfer_amount"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{@string/my_items_item_balance(mobilePayment.paymentAmount, "AZN")}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="ugurlu" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/twenty_four_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/commission"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{@string/my_items_item_balance(mobilePayment.commissionAmount, "AZN")}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="15 AZN" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/twenty_four_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/payment_type"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{mobilePayment.fillingMethod == 1 ? @string/manual : @string/from_qr_code}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="15 AZN" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>