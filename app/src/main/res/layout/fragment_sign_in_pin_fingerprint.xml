<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable name="customer_name" type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_btb_new_last_logo"
            android:layout_marginTop="@dimen/forty_two_dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/pinText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty_four_dp"
            android:layout_marginTop="@dimen/sixteen_dp"
            android:layout_marginEnd="@dimen/twenty_four_dp"
            android:text='@{customer_name}'
            android:gravity="center"
            android:textColor="@color/textColor"
            android:textSize="20sp"
            android:fontFamily="@font/sf_pro_semibold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lock"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="filankesov behmenkes" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/pinLayout"
            android:layout_width="200dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/sixteen_dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/twenty_dp"
            android:paddingEnd="@dimen/twenty_dp"
            app:layout_constraintEnd_toEndOf="@id/pinText"
            app:layout_constraintStart_toStartOf="@id/pinText"
            app:layout_constraintTop_toBottomOf="@+id/pinText">

            <ImageView
                android:id="@+id/pin1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_count_not_selected"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/pin2"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/pin2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_count_not_selected"
                app:layout_constraintStart_toEndOf="@id/pin1"
                app:layout_constraintEnd_toStartOf="@id/pin3"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/pin3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_count_not_selected"
                app:layout_constraintStart_toEndOf="@id/pin2"
                app:layout_constraintEnd_toStartOf="@id/pin4"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/pin4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/pin_count_not_selected"
                app:layout_constraintStart_toEndOf="@id/pin3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/pinText2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/twelve_dp"
            android:text="@string/_4_r_q_mli_ifr_ni_yaz_n"
            android:textColor="@color/textColorLight"
            android:textSize="17sp"
            android:gravity="center|top"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="@id/pinLayout"
            app:layout_constraintStart_toStartOf="@id/pinLayout"
            app:layout_constraintTop_toBottomOf="@+id/pinLayout" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/inputLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="@dimen/sixteen_dp"
            android:paddingEnd="@dimen/sixteen_dp"
            android:paddingBottom="@dimen/fifty_dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pinText2">

            <TextView
                android:id="@+id/number1"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="1"
                android:tag="1"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number5"
                app:layout_constraintEnd_toStartOf="@id/number2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/number2"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="2"
                android:tag="2"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number5"
                app:layout_constraintEnd_toStartOf="@id/number3"
                app:layout_constraintStart_toEndOf="@id/number1"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/number3"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="3"
                android:tag="3"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/number2"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/number4"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="4"
                android:tag="4"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number8"
                app:layout_constraintEnd_toStartOf="@id/number2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/number1" />

            <TextView
                android:id="@+id/number5"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="5"
                android:tag="5"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number8"
                app:layout_constraintEnd_toStartOf="@id/number3"
                app:layout_constraintStart_toEndOf="@id/number1"
                app:layout_constraintTop_toBottomOf="@id/number1" />

            <TextView
                android:id="@+id/number6"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="6"
                android:tag="6"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/number2"
                app:layout_constraintTop_toBottomOf="@id/number1" />

            <TextView
                android:id="@+id/number7"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="7"
                android:tag="7"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number0"
                app:layout_constraintEnd_toStartOf="@id/number2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/number4" />

            <TextView
                android:id="@+id/number8"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="8"
                android:tag="8"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number0"
                app:layout_constraintEnd_toStartOf="@id/number3"
                app:layout_constraintStart_toEndOf="@id/number1"
                app:layout_constraintTop_toBottomOf="@id/number4" />

            <TextView
                android:id="@+id/number9"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="9"
                android:tag="9"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toTopOf="@id/number0"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/number2"
                app:layout_constraintTop_toBottomOf="@id/number4" />

            <TextView
                android:id="@+id/number0"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="0"
                android:tag="0"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:background="@drawable/shape_pin_number_not_selected"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/number8"
                app:layout_constraintStart_toStartOf="@id/number8"
                app:layout_constraintTop_toBottomOf="@id/number8" />

            <TextView
                android:id="@+id/numberX"
                android:layout_width="@dimen/sixty_dp"
                android:layout_height="@dimen/sixty_dp"
                android:gravity="center"
                android:text="@string/delete"
                android:tag="x"
                android:textStyle="bold"
                android:textColor="@color/textColorLight"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/number9"
                app:layout_constraintStart_toStartOf="@id/number9"
                app:layout_constraintTop_toBottomOf="@id/number9" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/fingerprint"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_fingerprint"
            android:layout_marginStart="@dimen/twenty_four_dp"
            android:layout_marginBottom="@dimen/twenty_four_dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/logout"
            style="@style/Widget.AppCompat.ActionButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_logout"
            android:layout_marginEnd="@dimen/twenty_four_dp"
            android:layout_marginBottom="@dimen/twenty_four_dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
