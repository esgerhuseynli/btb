<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable name="wasSucceeded" type="Boolean" />
        <variable name="destinationCardFormattedNumber" type="String" />
        <variable name="amount" type="java.math.BigDecimal" />
        <variable name="amountCurrency" type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ic_c2c_transaction_result_window_style">

        <ImageView
            android:id="@+id/transaction_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src='@{wasSucceeded ? @drawable/ic_success_big : @drawable/ic_error_big}'
            android:layout_marginTop="@dimen/ten_dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:src="@drawable/ic_error_big"/>

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text='@{wasSucceeded ? @string/successful_transfer : @string/failed_transfer}'
            android:textSize="20sp"
            android:layout_marginTop="@dimen/ten_dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/transaction_status"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="@string/failed_transfer"/>

        <View
            android:id="@+id/dashes"
            android:layout_width="match_parent"
            android:layout_height="@dimen/six_dp"
            android:layout_marginStart="@dimen/forty_two_dp"
            android:layout_marginTop="@dimen/twenty_dp"
            android:layout_marginEnd="@dimen/forty_two_dp"
            android:background="@drawable/dashed_view"
            app:layout_constraintTop_toBottomOf="@id/status_text" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/twenty_four_dp"
            android:layout_marginTop="@dimen/thirty_six_dp"
            app:layout_constraintTop_toBottomOf="@id/dashes"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/account_or_card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/destination_card_number"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{destinationCardFormattedNumber}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="mastercard 3231 **** **** 4343" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/second_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/forty_two_dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/operation_amount"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text='@{@string/my_items_item_balance(amount, amountCurrency)}'
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:textSize="15sp"
                        tools:text="315 USD" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/close_dialog"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginStart="@dimen/sixteen_dp"
                    android:layout_marginTop="@dimen/fifty_six_dp"
                    android:layout_marginEnd="@dimen/sixteen_dp"
                    android:layout_marginBottom="@dimen/sixteen_dp"
                    android:background="@drawable/shape_button_enabled"
                    android:elevation="3dp"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/thank_you"
                        android:textColor="@color/white"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>