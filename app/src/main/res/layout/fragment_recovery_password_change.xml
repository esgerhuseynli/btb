<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:animateLayoutChanges="true">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:src="@drawable/logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/textPasswordRecovery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/password_recovery"
                android:textColor="@color/textColorLight"
                android:textSize="21sp"
                android:fontFamily="@font/sf_pro_semibold"
                app:layout_constraintEnd_toEndOf="@id/logo"
                app:layout_constraintStart_toStartOf="@id/logo"
                app:layout_constraintTop_toBottomOf="@id/logo" />

            <TextView
                android:id="@+id/textNumberVerification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="26dp"
                android:gravity="center"
                android:textColor="@color/textColorLight"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@id/textPasswordRecovery"
                app:layout_constraintStart_toStartOf="@id/textPasswordRecovery"
                app:layout_constraintTop_toBottomOf="@id/textPasswordRecovery"
                tools:text="Təsdiq kodu +994 55 876 54 32 SMS - məktub vasitəsilə göndərildi." />

            <az.btb.mobilebanking.utils.OtpEditText
                android:id="@+id/verifyCode"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginStart="50dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="50dp"
                android:textColor="@color/textColor"
                android:textSize="20sp"
                android:inputType="phone"
                android:maxLength="7"
                android:textIsSelectable="false"
                android:cursorVisible="false"
                app:layout_constraintTop_toBottomOf="@id/textNumberVerification" />

            <TextView
                android:id="@+id/codeError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/second"
                android:textColor="@color/textColorLight"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@id/verifyCode"
                app:layout_constraintStart_toStartOf="@id/verifyCode"
                app:layout_constraintTop_toBottomOf="@id/verifyCode" />

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="@dimen/sixteen_dp"
                android:layout_marginTop="36dp"
                android:layout_marginEnd="@dimen/sixteen_dp"
                android:background="@drawable/shape_edit_text_selector"
                android:gravity="center|start"
                android:hint="@string/enter_new_password"
                android:inputType="textPassword"
                android:paddingStart="@dimen/twenty_four_dp"
                android:paddingEnd="@dimen/twenty_four_dp"
                android:textColor="@color/textColor"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/codeError" />

            <EditText
                android:id="@+id/passwordAgain"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="@dimen/sixteen_dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/sixteen_dp"
                android:layout_marginBottom="@dimen/sixteen_dp"
                android:background="@drawable/shape_edit_text_selector"
                android:gravity="center|start"
                android:hint="@string/password_again"
                android:inputType="textPassword"
                android:paddingStart="@dimen/twenty_four_dp"
                android:paddingEnd="@dimen/twenty_four_dp"
                android:textColor="@color/textColor"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/password" />

            <LinearLayout
                android:id="@+id/nextButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginStart="@dimen/sixteen_dp"
                android:layout_marginEnd="@dimen/sixteen_dp"
                android:layout_marginBottom="@dimen/sixteen_dp"
                android:background="@drawable/shape_button_selector"
                android:elevation="3dp"
                android:gravity="center"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:textSize="17sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>
